# ===== Conexões de banco =====
# MySQL (camada GOLD / relacional). Formato SQLAlchemy.
MYSQL_URI=mysql+mysqlconnector://<usuario>:<senha>@<host>:3306/<database>

# MongoDB (camadas BRONZE/SILVER). Use a mesma instância consumida pela API.
MONGO_URI=mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/?appName=<app>
MONGO_DB_NAME=ETL

# ===== Coleções =====
# Dados BRUTOS (bronze) — saída da extração do PNCP.
MONGO_COLLECTION=contratacoes_brutas
# Dados LIMPOS (silver) — com campos aninhados preservados; é a coleção
# consumida pela API e observada pelo streaming WebSocket.
MONGO_COLLECTION_LIMPAS=contratacoes_limpas

# ===== Pipeline =====
# Janela de datas MÓVEL da extração (em dias, até hoje). Default 30.
ETL_JANELA_DIAS=30
